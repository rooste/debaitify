# Dependencies
node_modules/

# Build output — regenerate with `npm run build`
dist/
dist-safari/
.vite/
*.tsbuildinfo

# Test and coverage output
coverage/
.vitest/

# Secrets. No API key belongs in this repo: keys live in chrome.storage.local
# on the user's own machine. See PRIVACY.md.
.env
.env.*
!.env.example
secrets/
*.pem
!tests/fixtures/*.pem
# Anything that announces itself as a credential. This repo is public and the
# extension is bring-your-own-key, so loose key files are a live hazard.
*.secret
*.key
key.*
*apikey*
*api-key*
*.token
.credentials

# Editor and OS cruft
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs
*.log
npm-debug.log*
.npm/

# Xcode. The project itself is committed; build output and the generated
# extension Resources (a copy of dist-safari/) are not.
safari/Debaitify/Shared (Extension)/Resources/
safari/build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
