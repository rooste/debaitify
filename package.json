{
  "name": "debaitify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replaces clickbait headlines with accurate ones generated from the article.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/check-bundles.mjs",
    "build:safari": "DEBAITIFY_TARGET=safari tsc --noEmit && DEBAITIFY_TARGET=safari vite build && node scripts/check-bundles.mjs dist-safari && node scripts/sync-safari.mjs",
    "sync:safari": "node scripts/sync-safari.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@mozilla/readability": "^0.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.9",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
